# Copier ce fichier en .env puis compléter les valeurs.

# --- Django ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- IA locale (Ollama + LangChain) ---
OLLAMA_BASE_URL=http://localhost:11434
# Agents : interprétation et explication uniquement (aucun calcul)
OLLAMA_MODEL=qwen3.5:4b
# Embeddings du RAG sur les fiches techniques
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT_SECONDS=240
# False = rapport 100 % déterministe, sans agents ni RAG
AI_AGENTS_ENABLED=True

# --- E-mail (Brevo SMTP) ---
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
DEFAULT_FROM_EMAIL=AIDE-IoT <noreply@example.com>
